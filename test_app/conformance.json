{
  "runtime": "elixir",
  "sdk_lang": 3,
  "command": {
    "test": "sh -c 'cd {app_dir} && FLEZHA_CA_CERT_PATH={ca_cert} FLEZHA_QUIC_CLIENT_CERT={client_cert} FLEZHA_QUIC_CLIENT_KEY={client_key} MIX_ENV=dev exec mix run --no-halt --no-deps-check -- {namespace}'",
    "bench": "sh -c 'cd {app_dir} && FLEZHA_CA_CERT_PATH={ca_cert} FLEZHA_QUIC_CLIENT_CERT={client_cert} FLEZHA_QUIC_CLIENT_KEY={client_key} MIX_ENV=prod exec mix run --no-halt --no-deps-check -- {namespace}'"
  },
  "artifacts": {
    "test": [
      "_build/dev/lib/elixir_runner/ebin"
    ],
    "bench": [
      "_build/prod/lib/elixir_runner/ebin",
      "_build/dev/lib/elixir_runner/ebin"
    ]
  },
  "build": {
    "test": "cd test/apps/elixir_runner && mix deps.get && MIX_ENV=dev mix compile",
    "bench": "cd test/apps/elixir_runner && mix deps.get && MIX_ENV=prod mix compile"
  },
  "connect_timeout_ms": 120000,
  "transports": [
    "uds",
    "quic"
  ],
  "dispatch": {
    "model": "process-per-cell",
    "detail": "One BEAM process per Cell, scheduled by the VM; there is no worker pool to size.",
    "env": {}
  },
  "toolchain": "elixir --version",
  "topology_surfaces": [
    "bounded",
    "branch",
    "sync_durability",
    "merge",
    "shorthand"
  ],
  "deferred": [],
  "fixtures": {
    "runner_lifecycle": [
      "do_nothing",
      "compare_filter",
      "bench_echo"
    ],
    "connect_discovery": [
      "do_nothing"
    ],
    "graph_builder": [
      "sugar_static_cell",
      "static_cell",
      "mixed_operator",
      "hybrid_channel",
      "merged_input",
      "transform_chain",
      "cell_stress",
      "bench_keyed_nopersist"
    ],
    "shorthand": [
      "sugar_do_nothing",
      "sugar_store_input",
      "sugar_named_input",
      "sugar_bounded",
      "sugar_bounded_per_input",
      "sugar_state_only"
    ],
    "liveness": [
      "wedge_probe"
    ],
    "retry_ladder": [
      "poison_probe",
      "bounded_mailbox_drop_nothing",
      "bounded_mailbox_drop_newest",
      "bounded_mailbox_drop_oldest"
    ],
    "partitioned": [
      "partition_relay",
      "dynamic_cell",
      "keyed_loop_bounded"
    ],
    "pool_wedge": [
      "wedge_probe"
    ],
    "state_persistence": [
      "store_input",
      "stateful_counter",
      "coalescing_counter",
      "persistence_off_counter",
      "sleeping_counter",
      "resume_probe",
      "bench_keyed"
    ],
    "keyed_channels": [
      "partition_relay"
    ],
    "dynamic_cell": [
      "dynamic_cell"
    ],
    "schema_evolution": [
      "schema_evolution_v1",
