{
  "runtime": "elixir",
  "sdk_lang": 3,
  "command": {
    "test": "sh -c 'cd {app_dir} && FLEZHA_CA_CERT_PATH={ca_cert} FLEZHA_QUIC_CLIENT_CERT={client_cert} FLEZHA_QUIC_CLIENT_KEY={client_key} MIX_ENV=dev exec mix run --no-halt --no-deps-check -- {namespace}'",
    "bench": "sh -c 'cd {app_dir} && FLEZHA_CA_CERT_PATH={ca_cert} FLEZHA_QUIC_CLIENT_CERT={client_cert} FLEZHA_QUIC_CLIENT_KEY={client_key} MIX_ENV=prod exec mix run --no-halt --no-deps-check -- {namespace}'"
  },
  "artifacts": {
    "test": [
      "_build/dev/lib/elixir_runner/ebin"
    ],
    "bench": [
      "_build/prod/lib/elixir_runner/ebin",
      "_build/dev/lib/elixir_runner/ebin"
    ]
  },
  "build": {
    "test": "cd test/apps/elixir_runner && mix deps.get && MIX_ENV=dev FLEZHA_SDK_BUILD_NIF=1 mix deps.compile flezha_sdk --force && MIX_ENV=dev mix compile",
    "bench": "cd test/apps/elixir_runner && mix deps.get && MIX_ENV=prod FLEZHA_SDK_BUILD_NIF=1 mix deps.compile flezha_sdk --force && MIX_ENV=prod mix compile"
  },
  "connect_timeout_ms": 120000,
  "transports": [
    "uds",
    "quic"
  ],
  "dispatch": {
    "model": "thread-pool",
    "detail": "A base pool of Elixir worker processes, each paired with a thread the native library owns that waits in the core's poll and hands the worker one activation at a time; a supervisor process grows the pool on the core's starvation signal.",
    "env": {
      "FLEZHA_WORKER_POOL_SIZE": "base workers (default: the schedulers online)",
      "FLEZHA_WORKER_POOL_MAX": "the ceiling the pool grows to on starvation (default: ten times the base)"
    }
  },
  "toolchain": "elixir --version",
  "topology_surfaces": [
    "steps",
    "branch",
    "merge",
    "shorthand",
    "call",
    "untyped_tree",
    "schema"
  ],
  "deferred": [],
  "fixtures": {
    "call_response": [
      "call_echo",
      "call_downstream",
      "call_split",
      "call_turn"
    ],
