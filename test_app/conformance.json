{
  "runtime": "elixir",
  "sdk_lang": 3,
  "command": {
    "test": "sh -c 'cd {app_dir} && FLEZHA_CA_CERT_PATH={ca_cert} FLEZHA_QUIC_CLIENT_CERT={client_cert} FLEZHA_QUIC_CLIENT_KEY={client_key} MIX_ENV=dev exec mix run --no-halt --no-deps-check -- {namespace}'",
    "bench": "sh -c 'cd {app_dir} && FLEZHA_CA_CERT_PATH={ca_cert} FLEZHA_QUIC_CLIENT_CERT={client_cert} FLEZHA_QUIC_CLIENT_KEY={client_key} MIX_ENV=prod exec mix run --no-halt --no-deps-check -- {namespace}'"
  },
  "artifacts": {
    "test": [
      "_build/dev/lib/elixir_runner/ebin"
    ],
    "bench": [
      "_build/prod/lib/elixir_runner/ebin",
      "_build/dev/lib/elixir_runner/ebin"
    ]
  },
  "build": {
    "test": "cd test/apps/elixir_runner && MIX_ENV=dev mix compile",
    "bench": "cd test/apps/elixir_runner && MIX_ENV=prod mix compile"
  },
  "connect_timeout_ms": 120000,
  "transports": [
    "uds",
    "quic"
  ],
  "dispatch": {
    "model": "process-per-entity",
    "detail": "One BEAM process per Entity, scheduled by the VM; there is no worker pool to size.",
    "env": {}
  },
  "toolchain": "elixir --version",
  "deferred": [],
  "fixtures": {
    "runner_lifecycle": [
      "do_nothing",
      "compare_filter",
      "bench_echo"
    ],
    "connect_discovery": [
      "do_nothing"
    ],
    "graph_builder": [
      "sugar_do_nothing",
      "sugar_store_input",
      "sugar_static_entity",
      "static_entity",
      "mixed_operative",
      "hybrid_channel",
      "entity_stress",
      "bench_keyed_nopersist"
    ],
    "liveness": [
      "wedge_probe"
    ],
    "retry_ladder": [
      "poison_probe",
      "bounded_mailbox_drop_nothing",
      "bounded_mailbox_drop_newest",
      "bounded_mailbox_drop_oldest"
    ],
    "entry_idle": [
      "entry_idle_probe"
    ],
    "partitioned": [
      "partition_relay",
      "dynamic_entity"
    ],
    "pool_wedge": [
      "wedge_probe"
    ],
    "state_persistence": [
      "store_input",
      "stateful_counter",
      "coalescing_counter",
      "persistence_off_counter",
      "resume_probe",
      "bench_keyed"
    ],
    "keyed_channels": [
      "partition_relay"
    ],
    "dynamic_entity": [
      "dynamic_entity"
    ],
    "schema_evolution": [
      "schema_evolution_v1",
      "schema_evolution_v2"
    ],
    "entity_timers": [
      "session_timeout"
    ],
    "effectively_once": [
      "tier_store",
      "checkpoint_store",
      "checkpoint_batched_store",
      "bench_checkpoint"
    ],
    "correction_window": [
      "candle"
    ],
    "workflow": [
      "echo_workflow",
      "commit_block_workflow",
      "sync_durable_workflow",
      "optout_commit_block",
      "tier_commit_block_workflow",
      "saga_block_workflow",
      "outbox_block_workflow",
      "undo_outbox_workflow",
      "chat_loop_workflow",
      "stateless_loop_workflow",
      "chat_rewind_workflow",
      "retry_workflow",
      "branch_workflow",
      "diamond_workflow",
      "bench_chain_1",
      "bench_chain_4",
      "bench_chain_16",
      "bench_chain_optout_4",
      "bench_loop_workflow"
    ]
  },
  "docs": "docs/sdk/elixir_sdk.md"
}
