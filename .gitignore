# Fetched from a core release and checked against its manifest: the fake
# controller, and the contract set the fixture tests resolve against.
/.core/
/contract/**
!/contract/**/
# The member the package compiles from is tracked, so a clone and the Hex
# package compile without a release; the core's conformance gate holds it equal.
!/contract/flz_transport/errors.json
# Copied from a core release by `scripts/fetch-core.sh`; a Hex release carries it.
/checksum-Elixir.Flezha.SDK.Native.exs
/native/flz_core_beam/Cargo.lock
/tmp/

# The starter is a project of its own and commits its lock; this repository does not.
/examples/starter/mix.lock
